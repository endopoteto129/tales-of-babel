# ボタン名を今の入力方法に合わせて差し込む
static func text_of(id: String) -> String:
	var t: String = DATA[id]["text"]
	for k in ["attack", "arte", "jump", "guard", "target", "link", "overlimit", "skit", "menu", "accept", "move", "allies"]:
		t = t.replace("{%s}" % k, "[color=#ffd27a][%s][/color]" % Game.key(k))
	return t
