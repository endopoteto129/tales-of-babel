# 敵の攻撃データから、予告の種類を決める
static func kind_of(at: Dictionary) -> String:
	var w: String = at.get("warn", "")
	if "跳" in w or "飛" in w:
		return "jump"
	if "ガード" in w or at.get("guardable", false):
		return "guard"
	if at.has("projectile"):
		return "magic" if at.get("magic", false) else "ranged"
	if at.get("magic", false) or at.has("aoe"):
		return "magic"
	return "melee"
