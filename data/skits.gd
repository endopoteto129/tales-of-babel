# 料理の会話
static func cook_lines(cook: String, rid: String, best: bool) -> Array:
	var r: Dictionary = DB.Items.RECIPES.get(rid, {"name": "料理"})
	var lines: Array = []
	var aside = "pots" if not Game.flags.get("pots_absent", false) else ""
	match cook:
		"ren":
			lines.append(["ren", "……軍の料理当番で覚えた。期待はするなよ。", ""])
			if best:
				lines.append(["", "レンの握ったおにぎりは、不格好だが、やけに温かかった。"])
				lines.append(["ren", "……塩加減だけは、自信がある。", "smile"])
			else:
				lines.append(["ren", "……レシピ通りに作ったはずなんだが。", "sweat"])
		"angie":
			lines.append(["angie", "料理も魔術も同じ！　大事なのは情熱よ！　ファイアボール！", "laugh"])
			if best:
				lines.append(["angie", "ほら見なさい！　見た目も味も完璧！　きらきらでしょ！？", "laugh"])
				lines.append(["", "星屑のように輝くパフェに、全員が息をのんだ。"])
			else:
				lines.append(["", "鍋の中身は、少し焦げていた。"])
				lines.append(["angie", "……火力の調整って、難しいのよね。", "sweat"])
		"sona":
			lines.append(["sona", "研究で薬草には詳しいの。体にいいものを作るわ。", ""])
			if best:
				lines.append(["sona", "はい、薬草スープ。弟が風邪をひいたとき、よく作ったの。", "smile"])
				lines.append(["", "やさしい香りが、焚火のまわりに広がった。"])
			else:
				lines.append(["sona", "……味より栄養。文句は聞かないわよ。", ""])
		"jin":
			lines.append(["jin", "ほな、アヅマの家庭の味をお見せしよか。", "smile"])
			if best:
				lines.append(["jin", "打ちたての蕎麦や。ずるずるっと音立てて食べるのが作法やで。", "smile"])
				lines.append(["nine", "ずるずるー！　おいしい！", "laugh"])
			else:
				lines.append(["jin", "……正直に言うわ。これ、ちょっと失敗した。", "sweat"])
		"john":
			lines.append(["john", "……闘技場じゃ、自分で作らなきゃ食えなかった。", ""])
			if best:
				lines.append(["john", "肉は大きく切る。それが一番うまい。", "smile"])
				lines.append(["", "豪快なカレーの香りに、腹の虫が一斉に鳴いた。"])
			else:
				lines.append(["john", "……量だけは、ある。", ""])
		_:
			lines.append([cook, "できたぞ。", "smile"])
	if not Game.flags.get("nine_absent", false):
		lines.append(["nine", ["おいしーい！　おかわり！", "いただきまーす！　……おいしい！", "ナイン、この味ぜったい忘れない！"][Game.rng.randi() % 3], "laugh"])
	if aside != "":
		lines.append(["pots", "%sの効果を確認しました。%d戦のあいだ持続します。" % [r["name"], 4 if best else 3], ""])
	return lines


# 休むだけのときの会話
static func rest_lines() -> Array:
	var cands: Array = []
	if not Game.flags.get("nine_absent", false):
		cands.append([["nine", "……すぴー……。レン……むにゃ……。", "smile"], ["ren", "……おやすみ。", "smile"]])
		cands.append([["nine", "レン、手、つないで寝てもいい？", "smile"], ["ren", "……ああ。", "smile"]])
	if Game.is_joined("john"):
		cands.append([["john", "見張りはオレがやる。お前らは寝ろ。", ""], ["ren", "……交代の時間になったら起こしてくれ。", ""]])
	if Game.is_joined("angie"):
		cands.append([["angie", "ふぁ……さすがに今日は疲れたわ……。", "sweat"], ["ren", "早めに休もう。明日も長い。", ""]])
	if Game.is_joined("jin"):
		cands.append([["jin", "ほな、ボクはもうひと書きしてから寝よかな。", "smile"], ["ren", "……ほどほどにな。", ""]])
	if cands.is_empty():
		cands.append([["ren", "……少し休もう。", ""]])
	return cands[Game.rng.randi() % cands.size()]


static func shop_greeting() -> String:
	var g := ["イラッシャイ、上ヘ昇ル人。", "ヒヒ、マタ会ッタナ。", "ナンデモアル。タブン。", "塔ノ品ハ、塔ノ中デシカ買エナイヨ。"]
	return g[Game.rng.randi() % g.size()]


static func shop_comment() -> Array:
	var cands: Array = []
	if not Game.flags.get("nine_absent", false):
		cands.append(["nine", "わあ、きらきらしたのがいっぱい！　ねえレン、どれ買うの？"])
		cands.append(["nine", "お店の人、手がいっぱいあるね！　べんりそう！"])
	if not Game.flags.get("pots_absent", false):
		cands.append(["pots", "相場を解析しました。……やや割高です。"])
	if Game.is_joined("angie"):
		cands.append(["angie", "ちょっと！　その護符、古代術式が刻んであるじゃない！　見せて見せて！"])
	if Game.is_joined("sona"):
		cands.append(["sona", "無駄遣いはだめよ。……グミは多めに買っておきなさい。"])
	if Game.is_joined("jin"):
		cands.append(["jin", "値切ったろか？　ボク、嘘つかれへんから交渉弱いんやけど。"])
	if Game.is_joined("john"):
		cands.append(["john", "……肉は、売ってないのか。"])
	if cands.is_empty():
		return []
	return cands[Game.rng.randi() % cands.size()]
